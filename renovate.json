{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:js-app",
        "group:linters",
        "group:monorepos",
        "group:recommended",
        "schedule:weekdays",
        ":automergeMinor",
        ":automergePr",
        ":automergeRequireAllStatusChecks",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":label(dependencies)"
    ],
    "enabledManagers": ["npm"],
    "minimumReleaseAge": "5 days",
    "postUpdateOptions": ["npmDedupe"],
    "packageRules": [
        {
            "matchManagers": ["github-actions"],
            "enabled": false
        },
        {
            "matchPackageNames": ["@types/react", "@types/react-dom"],
            "groupName": "react monorepo"
        },
        {
            "matchPackageNames": ["oxlint", "oxfmt"],
            "groupName": "ox toolchain",
            "description": "Group oxlint and oxfmt updates into a single PR"
        },
        {
            "matchPackageNames": ["@nestjs/**", "nestjs-zod"],
            "groupName": "NestJS",
            "description": "update every NestJS package in one PR, together with nestjs-zod which pins the @nestjs/common peer range - a split bump leaves peers that cannot resolve"
        },
        {
            "matchPackageNames": [
                "@agentclientprotocol/sdk",
                "@agentclientprotocol/claude-agent-acp"
            ],
            "groupName": "ACP",
            "description": "The Claude Code ACP adapter depends on the ACP SDK; bump them together so the protocol versions stay aligned"
        }
    ]
}
