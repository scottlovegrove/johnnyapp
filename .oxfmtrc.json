{
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 100,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": false,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "singleAttributePerLine": false,
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/public/**",
        "**/*.css",
        "**/package.json"
    ]
}
