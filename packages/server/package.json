{
  "name": "johnny",
  "version": "0.0.1",
  "description": "Web chat front-end for locally installed AI coding agents",
  "type": "module",
  "bin": {
    "johnny": "./dist/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -b && rm -rf public && cp -r ../web/dist public",
    "dev": "JOHNNY_DEV=1 tsx watch --clear-screen=false src/index.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.1",
    "@johnny/shared": "*",
    "@zed-industries/claude-code-acp": "^0.16.2",
    "hono": "^4.13.9",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=22"
  }
}
