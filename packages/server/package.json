{
  "name": "johnny",
  "version": "0.0.1",
  "description": "Web chat front-end for locally installed AI coding agents",
  "bin": {
    "johnny": "./dist/main.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "nest build && rm -rf public && cp -r ../web/dist public",
    "dev": "JOHNNY_DEV=1 nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.85.1",
    "@agentclientprotocol/sdk": "1.7.0",
    "@johnny/shared": "*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-ws": "12.1.2",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/websockets": "12.1.2",
    "nestjs-zod": "5.5.0",
    "open": "11.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
