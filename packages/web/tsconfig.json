{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "sourceMap": false,
        "baseUrl": ".",
        "paths": { "@/*": ["./src/*"] },
        "types": ["vite/client"]
    },
    "include": ["src"],
    "references": [{ "path": "../shared" }]
}
