{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "sourceMap": false,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
    },
    "include": ["src", "vitest.config.ts"],
    "references": [
        {
            "path": "../shared"
        }
    ]
}
